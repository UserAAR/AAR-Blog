---
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getAboutPost } from "@utils/content-utils";
import { fetchPageBlocks } from "@/lib/notion";
import { renderNotionBlocks } from "@/lib/notion-renderer";

const aboutPost = await getAboutPost();
const blocks = await fetchPageBlocks(aboutPost.id);
const { html: contentHtml } = renderNotionBlocks(blocks);
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Fragment set:html={contentHtml} />
            </Markdown>
        </div>
    </div>
</MainGridLayout>

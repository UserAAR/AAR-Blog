---
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	author?: string;
	class: string;
}

const { title, slug, pubDate, author } = Astro.props;
const className = Astro.props.class;
const licenseConf = licenseConfig;
const canonicalUrl = `https://log.aars.works/blog/${slug}/`;
const authorName = (author && author.trim() !== "" ? author : profileConfig.name);
---
<div class={`relative transition overflow-hidden bg-[var(--license-block-bg)] py-5 px-6 ${className}`}>
    <div class="transition font-bold text-black/75 dark:text-white/75">
        {title}
    </div>
    <div class="mt-1 flex flex-wrap items-center gap-2">
        <button
            type="button"
            class="btn-regular rounded-lg h-9 px-3 text-sm font-bold active:scale-95 flex items-center gap-2"
            data-share-action="copy"
            data-url={canonicalUrl}
        >
            <Icon name="fa6-regular:copy" class="text-[1.1rem]"></Icon>
            Copy link
        </button>

        <button
            type="button"
            class="btn-regular rounded-lg h-9 px-3 text-sm font-bold active:scale-95 flex items-center gap-2"
            data-share-action="native"
            data-url={canonicalUrl}
            data-title={title}
        >
            <Icon name="fa6-solid:share-nodes" class="text-[1.1rem]"></Icon>
            Share
        </button>

        <a
            aria-label="Share on X"
            class="btn-regular rounded-lg h-9 w-9 active:scale-95 flex items-center justify-center"
            target="_blank"
            rel="noopener noreferrer"
            href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalUrl)}&text=${encodeURIComponent(title)}`}
        >
            <Icon name="fa6-brands:twitter" class="text-[1.1rem]"></Icon>
        </a>

        <a
            aria-label="Share on WhatsApp"
            class="btn-regular rounded-lg h-9 w-9 active:scale-95 flex items-center justify-center"
            target="_blank"
            rel="noopener noreferrer"
            href={`https://wa.me/?text=${encodeURIComponent(`${title} ${canonicalUrl}`)}`}
        >
            <Icon name="fa6-brands:whatsapp" class="text-[1.1rem]"></Icon>
        </a>

        <a
            aria-label="Share on LinkedIn"
            class="btn-regular rounded-lg h-9 w-9 active:scale-95 flex items-center justify-center"
            target="_blank"
            rel="noopener noreferrer"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
        >
            <Icon name="fa6-brands:linkedin" class="text-[1.1rem]"></Icon>
        </a>
    </div>
    <div class="flex gap-6 mt-2">
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.author)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{authorName}</div>
        </div>
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.publishedAt)}</div>
            <div class="transition text-black/75 dark:text-white/75 line-clamp-2">{formatDateToYYYYMMDD(pubDate)}</div>
        </div>
        <div>
            <div class="transition text-black/30 dark:text-white/30 text-sm">{i18n(I18nKey.license)}</div>
            <a href={licenseConf.url} target="_blank" class="link text-[var(--primary)] line-clamp-2">{licenseConf.name}</a>
        </div>
    </div>
    <Icon name="fa6-brands:creative-commons" class="transition text-[15rem] absolute pointer-events-none right-6 top-1/2 -translate-y-1/2 text-black/5 dark:text-white/5"></Icon>
</div>
